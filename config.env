# Multi-IP Setup Configuration
# This file is optional - scripts will auto-detect most settings
# Copy this file to config.env and modify as needed

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Network Interface (auto-detected)
# Examples: eth0, ens3, enp0s3, ens18
# Leave empty for auto-detection
INTERFACE=""

# Main IP and Gateway (auto-detected)
# These will be detected from your current network configuration
MAIN_IP=""
MAIN_GW=""

# Additional IP Subnet
# Replace with your actual additional IP range provided by your hosting company
# Format: CIDR notation (e.g., 192.168.1.0/24, 10.0.0.0/24)
SUBNET="10.0.0.0/24"

# IP Range to configure
# Adjust based on how many IPs you have available
START_IP=1
END_IP=254

# =============================================================================
# ROUTING CONFIGURATION
# =============================================================================

# Starting number for routing tables
# Each IP gets its own routing table starting from this number
TABLE_START=1001

# Reverse Path Filtering
# 0=disabled, 1=strict, 2=loose (recommended: 0 for multi-IP)
RP_FILTER=0

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================

# Systemd service name for persistence
PERSISTENCE_SERVICE="multi-ip-setup"

# Backup directory
BACKUP_DIR="/backup/multi-ip"

# =============================================================================
# DIAGNOSTIC CONFIGURATION
# =============================================================================

# Port for diagnostic web server
DIAGNOSTIC_PORT=8083

# URLs for connectivity testing
CONNECTIVITY_TEST_URL="http://ifconfig.me/"
CONNECTIVITY_TEST_URL_BACKUP="http://ipinfo.io/ip"

# Test timeout in seconds
CONNECTIVITY_TIMEOUT=5

# IPs to test during diagnostics (comma-separated)
TEST_IPS="10.0.0.5,10.0.0.100"

# =============================================================================
# FIREWALL CONFIGURATION
# =============================================================================

# Auto-flush firewall during fix (true/false)
# WARNING: This will remove all firewall rules
AUTO_FLUSH_FIREWALL=false

# Default firewall policy during setup
# Options: ACCEPT, DROP (recommended: ACCEPT for initial setup)
FIREWALL_POLICY="ACCEPT"

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Enable verbose logging (true/false)
VERBOSE_LOGGING=true

# Log file location
LOG_FILE="/var/log/multi-ip-setup.log"

# =============================================================================
# ADVANCED SETTINGS (Usually no need to change)
# =============================================================================

# Interface label prefix for additional IPs
INTERFACE_LABEL_PREFIX="multi-ip"

# Routing rule priority start
RULE_PRIORITY_START=10000

# Systemd service dependencies
SERVICE_DEPENDENCIES="network.target"

# =============================================================================
# PROVIDER-SPECIFIC SETTINGS
# =============================================================================

# Uncomment and adjust based on your hosting provider requirements

# For Hetzner:
# INTERFACE="ens3"
# SUBNET="10.0.0.0/24"

# For DigitalOcean:
# INTERFACE="eth0"
# SUBNET="10.0.0.0/24"

# For Vultr:
# INTERFACE="ens3"
# SUBNET="10.0.0.0/24"

# For AWS:
# INTERFACE="eth0"
# SUBNET="10.0.0.0/24"

# For Google Cloud:
# INTERFACE="ens4"
# SUBNET="10.0.0.0/24"

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# Example 1: Small range (8 IPs)
# SUBNET="192.168.1.0/29"
# START_IP=1
# END_IP=6

# Example 2: Medium range (64 IPs)
# SUBNET="10.1.0.0/26"
# START_IP=1
# END_IP=62

# Example 3: Large range (256 IPs)
# SUBNET="172.16.1.0/24"
# START_IP=1
# END_IP=254

# =============================================================================
# TROUBLESHOOTING SETTINGS
# =============================================================================

# Enable debug mode (very verbose)
DEBUG=false

# Skip specific operations (comma-separated)
# Options: backup,ip_setup,routing,firewall,persistence
SKIP_OPERATIONS=""

# Force operations (comma-separated)
# Options: interface_detection,ip_detection,gateway_detection
FORCE_OPERATIONS=""