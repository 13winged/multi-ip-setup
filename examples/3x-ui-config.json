{
  "api": {
    "services": [
      "StatsService"
    ],
    "tag": "api"
  },
  "inbounds": [
    {
      "tag": "main-vless",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "a0e8c1d5-6f3b-4a2c-8d1e-9f0a3b2c1d4e",
            "flow": "xtls-rprx-vision",
            "email": "user@example.com"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "www.cloudflare.com:443",
          "xver": 0,
          "serverNames": [
            "www.cloudflare.com"
          ],
          "privateKey": "mK1DVrYFkCgHyfCsAyO7X1SwW3UqcgR5N7pXvTpW_hA",
          "minClientVer": "",
          "maxClientVer": "",
          "maxTimeDiff": 0,
          "shortIds": [
            "a1b2c3d4"
          ]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ]
      },
      "bind": "10.0.0.5",
      "remark": "Main VLESS Reality Service"
    },
    {
      "tag": "secondary-trojan",
      "port": 8443,
      "protocol": "trojan",
      "settings": {
        "clients": [
          {
            "password": "your_secure_password_here",
            "email": "trojan-user@example.com"
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "your-domain.com",
          "certificates": [
            {
              "certificateFile": "/etc/x-ui/cert.pem",
              "keyFile": "/etc/x-ui/key.pem"
            }
          ]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ]
      },
      "bind": "10.0.0.6",
      "remark": "Secondary Trojan Service"
    },
    {
      "tag": "backup-vmess",
      "port": 8080,
      "protocol": "vmess",
      "settings": {
        "clients": [
          {
            "id": "b1c2d3e4-f5g6-7h8i-9j0k-l1m2n3o4p5q6",
            "alterId": 0,
            "email": "vmess-user@example.com"
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/graphql",
          "headers": {}
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ]
      },
      "bind": "10.0.0.7",
      "remark": "Backup VMess WebSocket"
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIP"
      },
      "bind": "10.0.0.8"
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {}
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "domain": [
          "geosite:category-ads-all"
        ],
        "outboundTag": "block"
      }
    ]
  },
  "policy": {
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true
    }
  }
}